# Copia este archivo como `.env` y completa los valores de tu proyecto Supabase.
# Los encuentras en: Supabase → Project Settings → API
#
# Este archivo SÍ se sube al repositorio (solo contiene nombres, no secretos).
# El archivo `.env` NUNCA se sube: está ignorado en .gitignore.

# URL del proyecto, con forma https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave pública "anon". Es segura de exponer en el navegador:
# el acceso a los datos lo controlan las políticas RLS de PostgreSQL.
# NUNCA pongas aquí la clave `service_role`.
VITE_SUPABASE_ANON_KEY=
